  exact ⟨pow_eq_zero_iff (n := 4) (by norm_num) |>.mp (alg3_0 u0 u1 u2 z0 z1 z2 g02 g03 g11 g12 g20 g21 g30), pow_eq_zero_iff (n := 4) (by norm_num) |>.mp (alg3_1 u0 u1 u2 z0 z1 z2 g02 g03 g11 g12 g20 g21 g30), pow_eq_zero_iff (n := 4) (by norm_num) |>.mp (alg3_2 u0 u1 u2 z0 z1 z2 g02 g03 g11 g12 g20 g21 g30)⟩

theorem zero_of_coords (t : Fin 3 × Fin 3 → ℂ) (hr : ∀ i, ∑ j, t (i, j) = 0)
    (hc : ∀ j, ∑ i, t (i, j) = 0) (h0 : t (0, 0) = 0) (h1 : t (0, 1) = 0)
    (h2 : t (1, 0) = 0) (h3 : t (1, 1) = 0) : t = 0 := by
  obtain ⟨e1, e2, e3, e4, e5⟩ := entries t hr hc
  funext ⟨i, j⟩
  fin_cases i <;> fin_cases j <;> simp_all

theorem spanE (K : Submodule ℂ (Fin 3 × Fin 3 → ℂ))
    (hcen : ∀ t ∈ K, (∀ i, ∑ j, t (i, j) = 0) ∧ (∀ j, ∑ i, t (i, j) = 0))
    (hP : ∀ t ∈ K, MvPolynomial.eval (fun p => 1 + t p) (PEqualNP.Gct.permPoly ℂ 3) = 6)
    (u z : Fin 3 × Fin 3 → ℂ) (hu : u ∈ K) (hz : z ∈ K) (x y : ℂ) :
    F (x * u (0, 0) + y * z (0, 0)) (x * u (0, 1) + y * z (0, 1))
      (x * u (1, 0) + y * z (1, 0)) (x * u (1, 1) + y * z (1, 1)) = 0 := by
  have hm : x • u + y • z ∈ K := K.add_mem (K.smul_mem x hu) (K.smul_mem y hz)
  have h1 := hP _ hm
  rw [key _ (hcen _ hm).1 (hcen _ hm).2] at h1
  simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul] at h1
  linear_combination h1

theorem dep (K : Submodule ℂ (Fin 3 × Fin 3 → ℂ))
    (hcen : ∀ t ∈ K, (∀ i, ∑ j, t (i, j) = 0) ∧ (∀ j, ∑ i, t (i, j) = 0))
    (hP : ∀ t ∈ K, MvPolynomial.eval (fun p => 1 + t p) (PEqualNP.Gct.permPoly ℂ 3) = 6)
    (u : Fin 3 × Fin 3 → ℂ) (hu : u ∈ K) (p : Fin 3 × Fin 3)
    (hp : p = (0, 0) ∨ p = (0, 1) ∨ p = (1, 0) ∨ p = (1, 1)) (hup : u p = 1)
    (w : Fin 3 × Fin 3 → ℂ) (hw : w ∈ K) : w p • u = w := by
  set z := w - w p • u with hzdef
  have hz : z ∈ K := K.sub_mem hw (K.smul_mem _ hu)
  have hzp : z p = 0 := by simp [hzdef, hup]
  have E := spanE K hcen hP u z hu hz
  have zc : z (0, 0) = 0 ∧ z (0, 1) = 0 ∧ z (1, 0) = 0 ∧ z (1, 1) = 0 := by
    rcases hp with rfl | rfl | rfl | rfl
    · obtain ⟨a, b, c⟩ := alg0 (u (0, 1)) (u (1, 0)) (u (1, 1)) (z (0, 1)) (z (1, 0)) (z (1, 1))
        (fun x y => by have := E x y; rwa [hup, hzp] at this)
      exact ⟨hzp, a, b, c⟩
    · obtain ⟨a, b, c⟩ := alg1 (u (0, 0)) (u (1, 0)) (u (1, 1)) (z (0, 0)) (z (1, 0)) (z (1, 1))
        (fun x y => by have := E x y; rwa [hup, hzp] at this)
      exact ⟨a, hzp, b, c⟩
    · obtain ⟨a, b, c⟩ := alg2 (u (0, 0)) (u (0, 1)) (u (1, 1)) (z (0, 0)) (z (0, 1)) (z (1, 1))
        (fun x y => by have := E x y; rwa [hup, hzp] at this)
      exact ⟨a, b, hzp, c⟩
    · obtain ⟨a, b, c⟩ := alg3 (u (0, 0)) (u (0, 1)) (u (1, 0)) (z (0, 0)) (z (0, 1)) (z (1, 0))
        (fun x y => by have := E x y; rwa [hup, hzp] at this)
      exact ⟨a, b, c, hzp⟩
  have h0 : z = 0 :=
    zero_of_coords z (hcen z hz).1 (hcen z hz).2 zc.1 zc.2.1 zc.2.2.1 zc.2.2.2
  rw [hzdef, sub_eq_zero] at h0
  exact h0.symm

end PEqualNP.Outside.L_gct_109_aux

open PEqualNP.Outside.L_gct_109_aux in
theorem PEqualNP.Outside.L_gct_109 : ∀ K : Submodule ℂ (Fin 3 × Fin 3 → ℂ), (∀ t ∈ K, (∀ i, ∑ j, t (i, j) = 0) ∧ (∀ j, ∑ i, t (i, j) = 0)) → (∀ t ∈ K, MvPolynomial.eval (fun p => 1 + t p) (PEqualNP.Gct.permPoly ℂ 3) = 6) → Module.finrank ℂ K ≤ 1 := by
  intro K hcen hP
  by_cases hex : ∃ u ∈ K, u ≠ 0
  · obtain ⟨u, hu, hu0⟩ := hex
    obtain ⟨p, hp, hpu⟩ : ∃ p : Fin 3 × Fin 3,
        (p = (0, 0) ∨ p = (0, 1) ∨ p = (1, 0) ∨ p = (1, 1)) ∧ u p ≠ 0 := by
      by_contra hall
      push Not at hall
      exact hu0 (zero_of_coords u (hcen u hu).1 (hcen u hu).2 (hall _ (Or.inl rfl))
        (hall _ (Or.inr (Or.inl rfl))) (hall _ (Or.inr (Or.inr (Or.inl rfl))))
        (hall _ (Or.inr (Or.inr (Or.inr rfl)))))
    have hu' : (u p)⁻¹ • u ∈ K := K.smul_mem _ hu
    have hup : ((u p)⁻¹ • u) p = 1 := by simp [hpu]
    refine finrank_le_one (⟨(u p)⁻¹ • u, hu'⟩ : K) fun w => ⟨w.1 p, ?_⟩
    apply Subtype.ext
    exact dep K hcen hP _ hu' p hp hup w.1 w.2
  · push Not at hex
    refine finrank_le_one (0 : K) fun w => ⟨0, ?_⟩
    apply Subtype.ext
    simp [hex w.1 w.2]
