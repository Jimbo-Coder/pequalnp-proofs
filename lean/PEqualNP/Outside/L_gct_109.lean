namespace PEqualNP.Outside.L_gct_109_aux

theorem perm3 (w : Fin 3 × Fin 3 → ℂ) :
    MvPolynomial.eval w (PEqualNP.Gct.permPoly ℂ 3) =
      w (0, 0) * w (1, 1) * w (2, 2) + w (0, 0) * w (1, 2) * w (2, 1)
      + w (0, 1) * w (1, 0) * w (2, 2) + w (0, 1) * w (1, 2) * w (2, 0)
      + w (0, 2) * w (1, 0) * w (2, 1) + w (0, 2) * w (1, 1) * w (2, 0) := by
  have sum_perm_succ : ∀ {n : ℕ} (g : Equiv.Perm (Fin (n + 1)) → ℂ),
      ∑ σ, g σ = ∑ a : Fin (n + 1), ∑ τ : Equiv.Perm (Fin n),
        g (Equiv.Perm.decomposeFin.symm (a, τ)) := by
    intro n g
    rw [← Equiv.Perm.decomposeFin.symm.sum_comp, Fintype.sum_prod_type]
  simp only [PEqualNP.Gct.permPoly, Matrix.permanent, map_sum, map_prod,
    Matrix.mvPolynomialX_apply, MvPolynomial.eval_X]
  rw [sum_perm_succ]
  simp only [sum_perm_succ (n := 1), sum_perm_succ (n := 0)]
  simp only [Fin.sum_univ_succ, Fin.sum_univ_zero, Fin.prod_univ_succ, Fin.prod_univ_zero,
    Equiv.Perm.decomposeFin_symm_apply_zero, Equiv.Perm.decomposeFin_symm_apply_succ,
    Fintype.sum_unique]
  simp +decide [Equiv.swap_apply_def]
  ring

/-- the centred permanent defect in the coordinates a = t(0,0), b = t(0,1), c = t(1,0), d = t(1,1) -/
def F (a b c d : ℂ) : ℂ :=
  (2*a^2 + 2*a*b + 2*a*c + a*d + 2*b^2 + b*c + 2*b*d + 2*c^2 + 2*c*d + 2*d^2)
  + 2*(a^2*d + 2*a*b*c + 2*a*b*d + 2*a*c*d + a*d^2 + b^2*c + b*c^2 + 2*b*c*d)

theorem entries (t : Fin 3 × Fin 3 → ℂ) (hr : ∀ i, ∑ j, t (i, j) = 0)
    (hc : ∀ j, ∑ i, t (i, j) = 0) :
    t (0, 2) = -t (0, 0) - t (0, 1) ∧ t (1, 2) = -t (1, 0) - t (1, 1) ∧
    t (2, 0) = -t (0, 0) - t (1, 0) ∧ t (2, 1) = -t (0, 1) - t (1, 1) ∧
    t (2, 2) = t (0, 0) + t (0, 1) + t (1, 0) + t (1, 1) := by
  have r0 := hr 0; have r1 := hr 1; have c0 := hc 0; have c1 := hc 1; have c2 := hc 2
  simp only [Fin.sum_univ_three] at r0 r1 c0 c1 c2
  exact ⟨by linear_combination r0, by linear_combination r1, by linear_combination c0,
    by linear_combination c1, by linear_combination c2 - r0 - r1⟩

theorem key (t : Fin 3 × Fin 3 → ℂ) (hr : ∀ i, ∑ j, t (i, j) = 0)
    (hc : ∀ j, ∑ i, t (i, j) = 0) :
    MvPolynomial.eval (fun p => 1 + t p) (PEqualNP.Gct.permPoly ℂ 3) =
      6 + F (t (0, 0)) (t (0, 1)) (t (1, 0)) (t (1, 1)) := by
  obtain ⟨e1, e2, e3, e4, e5⟩ := entries t hr hc
  rw [perm3]
  simp only [e1, e2, e3, e4, e5, F]
  ring


theorem coeffs0 (u1 u2 u3 z1 z2 z3 : ℂ)
    (E : ∀ x y : ℂ, F (x * 1 + y * 0) (x * u1 + y * z1) (x * u2 + y * z2) (x * u3 + y * z3) = 0) :
    2*z1^2 + z1*z2 + 2*z1*z3 + 2*z2^2 + 2*z2*z3 + 2*z3^2 = 0 ∧ 2*z1^2*z2 + 2*z1*z2^2 + 4*z1*z2*z3 = 0 ∧ 4*u1*z1 + u1*z2 + 2*u1*z3 + u2*z1 + 4*u2*z2 + 2*u2*z3 + 2*u3*z1 + 2*u3*z2 + 4*u3*z3 + 2*z1 + 2*z2 + z3 = 0 ∧ 4*u1*z1*z2 + 2*u1*z2^2 + 4*u1*z2*z3 + 2*u2*z1^2 + 4*u2*z1*z2 + 4*u2*z1*z3 + 4*u3*z1*z2 + 4*z1*z2 + 4*z1*z3 + 4*z2*z3 + 2*z3^2 = 0 ∧ 2*u1^2 + u1*u2 + 2*u1*u3 + 2*u1 + 2*u2^2 + 2*u2*u3 + 2*u2 + 2*u3^2 + u3 + 2 = 0 ∧ 2*u1^2*z2 + 4*u1*u2*z1 + 4*u1*u2*z2 + 4*u1*u2*z3 + 4*u1*u3*z2 + 4*u1*z2 + 4*u1*z3 + 2*u2^2*z1 + 4*u2*u3*z1 + 4*u2*z1 + 4*u2*z3 + 4*u3*z1 + 4*u3*z2 + 4*u3*z3 + 2*z3 = 0 ∧ 2*u1^2*u2 + 2*u1*u2^2 + 4*u1*u2*u3 + 4*u1*u2 + 4*u1*u3 + 4*u2*u3 + 2*u3^2 + 2*u3 = 0 := by
  have e0 := E 1 0
  have e1 := E 0 1
  have e2 := E (-1) 0
  have e3 := E 0 (-1)
  have e4 := E 1 1
  have e5 := E (-1) (-1)
  have e6 := E 1 (-1)
  simp only [F] at e0 e1 e2 e3 e4 e5 e6
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · linear_combination (1/2) * e1 + (1/2) * e3
  · linear_combination (1/2) * e1 + (-1/2) * e3
  · linear_combination (-1/2) * e0 + (-1/2) * e1 + (-1/2) * e2 + (-1/2) * e3 + (1/2) * e4 + (1/2) * e5
  · linear_combination (-1) * e0 + (-1/2) * e1 + (-1/2) * e3 + (1/2) * e4 + (1/2) * e6
  · linear_combination (1/2) * e0 + (1/2) * e2
  · linear_combination (1/2) * e0 + (1/2) * e2 + (1) * e3 + (-1/2) * e5 + (-1/2) * e6
  · linear_combination (1/2) * e0 + (-1/2) * e2

